# ---------------------------------------------------------------------------
# Videowalla Sales Command Center — environment
#
# Only the three variables in the REQUIRED block are needed to boot. Everything
# else is an integration credential; the app runs without them and reports each
# integration honestly as "not configured" rather than pretending to work.
#
# Prefer configuring integration credentials in the app (Settings →
# Integrations) where they are encrypted at rest. The variables below act as a
# bootstrap for deployment environments.
# ---------------------------------------------------------------------------

# --- REQUIRED --------------------------------------------------------------

DATABASE_URL="postgresql://user:password@localhost:5432/videowalla_crm?schema=public"

# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Exactly 64 hex characters (32 bytes). Encrypts integration secrets at rest.
# Generate with: openssl rand -hex 32
# WARNING: changing this makes every stored integration credential unreadable.
ENCRYPTION_KEY=""

# --- Strongly recommended --------------------------------------------------

# Public URL of this app. Used in invitation links and the OAuth redirect.
APP_URL="http://localhost:3000"

# Shared secret for POST /api/cron/tick. Only needed if you drive background
# jobs from an external scheduler instead of `npm run worker`.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- AI qualification (optional) -------------------------------------------
# Without either key the pipeline still runs end to end on the built-in
# deterministic rules engine, at lower confidence, and routes uncertain leads
# to Manual Review instead of the call queue.

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# auto | anthropic | openai | rules   (also settable in Settings → General)
AI_PROVIDER="auto"

# --- Google (optional) -----------------------------------------------------
# One OAuth client covers both Gmail ingestion and Calendar invitations.
# Create it at https://console.cloud.google.com/apis/credentials
#   * Enable the Gmail API and the Google Calendar API
#   * Authorised redirect URI: <APP_URL>/api/integrations/google/callback
#   * Scopes requested: gmail.readonly, calendar.events
# The owner then authorises each one from Settings → Integrations.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Places API (New) key for local company discovery. Billing must be enabled.
GOOGLE_PLACES_API_KEY=""

# --- Email delivery (optional) ---------------------------------------------
# Without this, notifications are in-app only and say so.

SMTP_URL=""
SMTP_FROM="Videowalla Sales <sales-leads@videowalla.co>"

# --- Worker tuning (optional) ----------------------------------------------

WORKER_CONCURRENCY="3"
WORKER_POLL_MS="2000"

# debug | info | warn | error
LOG_LEVEL="info"
